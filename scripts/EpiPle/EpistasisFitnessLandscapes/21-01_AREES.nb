     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"export", " ", "each", " ", "image"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"Export", "[", 
