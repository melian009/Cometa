Cell[CellGroupData[{

Cell["\<\
Figure 1 & S2 - random adaptive walks on larger RMF landscape\
\>", "Section",
 CellChangeTimes->{{3.850901720102374*^9, 3.850901728685758*^9}, {
  3.85141793365049*^9, 3.851417953482053*^9}, {3.851418864583497*^9, 
  3.851418864667944*^9}},ExpressionUUID->"7bb47cd1-bc73-4ba0-a029-\
ab8a00b1cff7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "define", " ", "parameter", " ", "combinations", " ", "to", " ", "use"}], 
    ",", " ", 
    RowBox[{"and", " ", "size", " ", "of", " ", "landscape"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"param", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0.2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.05", ",", "0.15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.1", ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.15", ",", "0.05"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.2", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "define", " ", "variance", " ", "of", " ", "additive", " ", "and", " ", 
      "epistatic", " ", "effects"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"varAdd", "=", 
       RowBox[{"param", "\[LeftDoubleBracket]", 
        RowBox[{"k", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"varEpi", "=", 
       RowBox[{"param", "\[LeftDoubleBracket]", 
        RowBox[{"k", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "define", " ", "genotypes", " ", "as", " ", "binary", " ", "vectors"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"genotypes", "=", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "draw", " ", "additive", " ", "and", " ", "epistatic", " ", "effects", 
        " ", "from", " ", "normal", " ", "distributions"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"effAdd", "=", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", "varAdd"}], "]"}], ",", "L"}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "L", "}"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"effEpi", "=", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", "varEpi"}], "]"}], ",", 
           RowBox[{"Length", "[", "genotypes", "]"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "genotypes", "]"}], "}"}]}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"compute", " ", "RMF", " ", "landscape"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"fitnessLandscape", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "genotypes", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{"Total", "[", 
            RowBox[{
            "genotypes", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
               "effAdd", "\[LeftDoubleBracket]", "j", 
                "\[RightDoubleBracket]"}], 
               RowBox[{"genotypes", "\[LeftDoubleBracket]", 
                RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{
                 "genotypes", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], "+", 
            RowBox[{
            "effEpi", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "genotypes", "]"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"extract", " ", "mutational", " ", "paths"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"mutTable", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{"fitnessLandscape", ",", "2"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
             "]"}], "==", "1"}], "&&", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"#", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
              RowBox[{"#", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "==",
             "1"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "compute", " ", "number", " ", "of", " ", "maxima", " ", "in", " ", 
        "the", " ", "landscape"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Select", "[", 
             RowBox[{"fitnessLandscape", ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
                 ">", 
                 RowBox[{"fitnessLandscape", "\[LeftDoubleBracket]", 
                  RowBox[{"k", ",", "3"}], "\[RightDoubleBracket]"}]}], "&&", 
                
                RowBox[{
                 RowBox[{"hamDist", "[", 
                  RowBox[{
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", 
                   RowBox[{"fitnessLandscape", "\[LeftDoubleBracket]", 
                    RowBox[{"k", ",", "1"}], "\[RightDoubleBracket]"}]}], 
                  "]"}], "\[Equal]", "1"}]}], "&"}]}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "fitnessLandscape", "]"}]}], "}"}]}], 
          "]"}], ",", "0"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "identify", " ", "least", " ", "fit", " ", "genotype", " ", "as", " ", 
        "starting", " ", "point", " ", "for", " ", "the", " ", 
        "simulations"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"leastFitGenotype", "=", 
       RowBox[{"fitnessLandscape", "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"fitnessLandscape", ",", 
           RowBox[{"Min", "[", 
            RowBox[{"fitnessLandscape", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "3"}], "\[RightDoubleBracket]"}], "]"}]}], 
          "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
        "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "create", " ", "empty", " ", "set", " ", "of", " ", "random", " ", 
        "walks"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"listOfRandomWalks", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"listOfPaths", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"set", " ", "starting", " ", "genotype"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"focal", "=", "leastFitGenotype"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"select", " ", "all", " ", "better", " ", "neighbors"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"goodNeighbors", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"fitnessLandscape", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
               ">", 
               RowBox[{
               "focal", "\[LeftDoubleBracket]", "3", 
                "\[RightDoubleBracket]"}]}], "&&", 
              RowBox[{
               RowBox[{"hamDist", "[", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                 ",", 
                 RowBox[{
                 "focal", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "]"}], "\[Equal]", "1"}]}], 
             "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"start", " ", "walk"}], " ", "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{"randomWalk", "=", 
          RowBox[{"{", "focal", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "goodNeighbors", "]"}], ">", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"find", " ", "fittest", " ", "neighbor"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"randomNeighbor", "=", 
             RowBox[{"RandomChoice", "[", "goodNeighbors", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "add", " ", "data", " ", "point", " ", "to", " ", "table"}], " ",
              "*)"}], "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"randomWalk", ",", "randomNeighbor"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"listOfPaths", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "focal", "\[LeftDoubleBracket]", "3", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{
                "randomNeighbor", "\[LeftDoubleBracket]", "3", 
                 "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"set", " ", "new", " ", "focal", " ", "genotype"}], " ", 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"focal", "=", "randomNeighbor"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"find", " ", "new", " ", "neighbors"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"goodNeighbors", "=", 
             RowBox[{"Select", "[", 
              RowBox[{"fitnessLandscape", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                   ">", 
                  RowBox[{
                  "focal", "\[LeftDoubleBracket]", "3", 
                   "\[RightDoubleBracket]"}]}], "&&", 
                 RowBox[{
                  RowBox[{"hamDist", "[", 
                   RowBox[{
                    RowBox[{
                    "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", 
                    RowBox[{
                    "focal", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}], "]"}], "\[Equal]", "1"}]}], 
                "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "stop", " ", "in", " ", "case", " ", "of", " ", "infinite", " ", 
              "loop", " ", "for", " ", "some", " ", "reason"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "randomWalk", "]"}], "\[Equal]", "20"}],
               ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"listOfRandomWalks", ",", "randomWalk"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "compute", " ", "1000", " ", "random", " ", "adaptive", " ", "walks",
           " ", "like", " ", "this"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", "1000", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "compute", " ", "and", " ", "print", " ", "number", " ", "of", " ", 
        "peaks", " ", "reached"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"reachedPeaks", "=", 
        RowBox[{
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"listOfRandomWalks", "\[LeftDoubleBracket]", 
           RowBox[{"All", ",", 
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], "]"}], "//", 
         "Length"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "compute", " ", "and", " ", "print", " ", "number", " ", "of", " ", 
        "unique", " ", "paths", " ", "taken"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"numberOfUniqueSteps", "=", 
        RowBox[{
         RowBox[{"DeleteDuplicates", "[", "listOfPaths", "]"}], "//", 
         "Length"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "compute", " ", "and", " ", "print", " ", "entropy", " ", "of", " ", 
        "unique", " ", "paths"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"entropyOfPaths", "=", 
        RowBox[{
         RowBox[{"Entropy", "[", "listOfPaths", "]"}], "//", "N"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "compute", " ", "and", " ", "pring", " ", "average", " ", "Hamming", 
         " ", "distance", " ", "between", " ", "peaks"}], ",", " ", 
        RowBox[{
        "with", " ", "and", " ", "without", " ", "paths", " ", "that", " ", 
         "reached", " ", "the", " ", "same", " ", "peak"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"peakDist", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"hamDist", "[", 
             RowBox[{
              RowBox[{"listOfRandomWalks", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", 
                RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}], 
              ",", 
              RowBox[{"listOfRandomWalks", "\[LeftDoubleBracket]", 
               RowBox[{"j", ",", 
                RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "2", ",", 
            RowBox[{"Length", "[", "listOfRandomWalks", "]"}]}], "}"}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", "peakDist", "]"}], "//", "N"}], ",", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"peakDist", ",", "0"}], "]"}], "]"}], "//", "N"}]}], 
        "}"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"visualize", " ", "distance", " ", "between", " ", "peaks"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Histogram", "[", "peakDist", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "create", " ", "plot", " ", "of", " ", "the", " ", "random", " ", 
        "walks"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"xx", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"listOfRandomWalks", "\[LeftDoubleBracket]", 
           RowBox[{"All", ",", "All", ",", 
            RowBox[{"2", ";;", "3"}]}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"Joined", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotStyle", "\[Rule]", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"Darker", "[", "Blue", "]"}], ",", 
             RowBox[{"Opacity", "[", "0.02", "]"}]}], "]"}]}], ",", 
          RowBox[{"Epilog", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Darker", "[", "Red", "]"}], ",", 
             RowBox[{"Opacity", "[", "0.1", "]"}], ",", 
             RowBox[{"PointSize", "[", "Large", "]"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Point", "[", 
                RowBox[{"listOfRandomWalks", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", 
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "3"}], "}"}]}], 
                 "\[RightDoubleBracket]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "listOfRandomWalks", "]"}]}], "}"}]}],
               "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "in", " ", "the", " ", "backhground", " ", "plot", " ", "the", " ",
             "complete", " ", "fitness", " ", "landscape"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Prolog", "\[Rule]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"Gray", ",", 
             RowBox[{"Opacity", "[", "0.1", "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"mutTable", "\[LeftDoubleBracket]", 
