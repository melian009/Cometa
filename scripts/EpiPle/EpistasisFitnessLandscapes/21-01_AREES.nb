Cell[BoxData[{
 RowBox[{
  RowBox[{"param", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0.2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.15"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.15", ",", "0.05"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.2", ",", "0"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "3"}], ";"}]}], "Input",
 CellChangeTimes->{{3.8508965903648043`*^9, 3.850896651717223*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"2b294a0a-acd6-4c7f-ba7c-8de9e46400fc"],

