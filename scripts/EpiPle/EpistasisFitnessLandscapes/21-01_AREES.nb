Cell["Function to compute Hamming distance between two genotypes", "Text",
 CellChangeTimes->{{3.85141494414043*^9, 3.8514149607446527`*^9}, 
   3.8514174070569963`*^9},ExpressionUUID->"2e8bdbb9-bdf9-49c8-971b-\
65476e8dc0e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hamDist", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"x", "-", "y"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"9cd4e136-c351-4ec1-beaa-d0b62380c47d"]
}, Closed]],

