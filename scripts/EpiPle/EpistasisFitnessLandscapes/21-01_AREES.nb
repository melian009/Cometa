Cell["\<\
Create several replicates of plots for each parameter combination\
\>", "Text",
 CellChangeTimes->{{3.851417438341514*^9, 
  3.851417458128459*^9}},ExpressionUUID->"1ba67671-71c0-4cc7-b683-\
6293edd39124"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "define", " ", "variance", " ", "of", " ", "additive", " ", "and", " ", 
    "epistatic", " ", "effects"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"varAdd", "=", 
     RowBox[{"param", "\[LeftDoubleBracket]", 
      RowBox[{"k", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"varEpi", "=", 
     RowBox[{"param", "\[LeftDoubleBracket]", 
      RowBox[{"k", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "define", " ", "genotypes", " ", "as", " ", "binary", " ", "vectors"}], 
     " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"genotypes", "=", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "draw", " ", "additive", " ", "and", " ", "epistatic", " ", "effects", 
       " ", "from", " ", "normal", " ", "distributions"}], ";", " ", 
      RowBox[{
      "if", " ", "variance", " ", "is", " ", "0", " ", "create", " ", "a", 
       " ", "table", " ", "of", " ", "0", "s"}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"effAdd", "=", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "varAdd"}], "]"}], ",", "L"}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", "L", "}"}]}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"effEpi", "=", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "varEpi"}], "]"}], ",", 
         RowBox[{"Length", "[", "genotypes", "]"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "genotypes", "]"}], "}"}]}], "]"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "compute", " ", "the", " ", "additive", " ", "part", " ", "of", " ", 
      "the", " ", "fitness", " ", "landscape"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"fitnessLandscapeAdd", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
         "genotypes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         ",", 
         RowBox[{"Total", "[", 
          RowBox[{
          "genotypes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
           "]"}], ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "effAdd", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
            
            RowBox[{"genotypes", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", 
              RowBox[{
              "genotypes", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}]}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "genotypes", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "extract", " ", "mutational", " ", "paths", " ", "from", " ", "additive",
       " ", "landscape"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"mutTableAdd", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{"fitnessLandscapeAdd", ",", "2"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
           "]"}], "==", "1"}], "&&", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "==",
           "1"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "compute", " ", "RMF", " ", "landscape", " ", "with", " ", "additive", 
      " ", "and", " ", "epistatic", " ", "parts"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"fitnessLandscape", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
         "genotypes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         ",", 
         RowBox[{"Total", "[", 
          RowBox[{
          "genotypes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
           "]"}], ",", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "effAdd", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
             RowBox[{"genotypes", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"Length", "[", 
               RowBox[{
               "genotypes", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], "+", 
          RowBox[{
          "effEpi", "\[LeftDoubleBracket]", "i", 
           "\[RightDoubleBracket]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "genotypes", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"extract", " ", "mutational", " ", "paths"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"mutTable", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{"fitnessLandscape", ",", "2"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
           "]"}], "==", "1"}], "&&", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "==",
           "1"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "create", " ", "plots", " ", "of", " ", "the", " ", "landscapes"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"xx", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Gray", ",", 
          RowBox[{"Opacity", "[", "0.2", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "plot", " ", "mutational", " ", "paths", " ", "of", " ", 
            "additive", " ", "landscape"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"mutTableAdd", "\[LeftDoubleBracket]", 
                RowBox[{"k", ",", "1", ",", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}],
                ",", 
               RowBox[{"mutTableAdd", "\[LeftDoubleBracket]", 
                RowBox[{"k", ",", "2", ",", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", "3"}], "}"}]}], 
                "\[RightDoubleBracket]"}]}], "}"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", "mutTable", "]"}]}], "}"}]}], "]"}], ",",
           "\[IndentingNewLine]", "White", ",", " ", 
          RowBox[{"Opacity", "[", "1", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "plot", " ", "additive", " ", "part", " ", "of", " ", "the", " ", 
            "landscape"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"StringJoin", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"ToString", "[", "#", "]"}], "&"}], ",", 
                   RowBox[{"fitnessLandscapeAdd", "\[LeftDoubleBracket]", 
                    RowBox[{"k", ",", "1"}], "\[RightDoubleBracket]"}]}], 
                  "]"}], "]"}], ",", 
                RowBox[{"fitnessLandscapeAdd", "\[LeftDoubleBracket]", 
                 RowBox[{"k", ",", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "3"}], "}"}]}], 
                 "\[RightDoubleBracket]"}]}], "]"}], ",", " ", 
              RowBox[{"FontFamily", "->", " ", "\"\<Andale Mono\>\""}], ",", 
              RowBox[{"Background", "\[Rule]", 
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"Opacity", "[", "0.2", "]"}], ",", "Gray"}], 
                "]"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", "fitnessLandscape", "]"}]}], "}"}]}], 
           "]"}], ",", "\[IndentingNewLine]", "Blue", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "plot", " ", "mutational", " ", "paths", " ", "of", " ", "RMF", 
            " ", "landscape"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"mutTable", "\[LeftDoubleBracket]", 
                RowBox[{"k", ",", "1", ",", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}],
                ",", 
               RowBox[{"mutTable", "\[LeftDoubleBracket]", 
                RowBox[{"k", ",", "2", ",", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", "3"}], "}"}]}], 
                "\[RightDoubleBracket]"}]}], "}"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", "mutTable", "]"}]}], "}"}]}], "]"}], ",",
           "\[IndentingNewLine]", "White", ",", " ", 
          RowBox[{"Opacity", "[", "1", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "plot", " ", "genotypes", " ", "of", " ", "RMF", " ", 
            "landscape"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"StringJoin", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"ToString", "[", "#", "]"}], "&"}], ",", 
                   RowBox[{"fitnessLandscape", "\[LeftDoubleBracket]", 
                    RowBox[{"k", ",", "1"}], "\[RightDoubleBracket]"}]}], 
                  "]"}], "]"}], ",", 
                RowBox[{"fitnessLandscape", "\[LeftDoubleBracket]", 
                 RowBox[{"k", ",", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "3"}], "}"}]}], 
                 "\[RightDoubleBracket]"}]}], "]"}], ",", " ", 
              RowBox[{"FontFamily", "->", " ", "\"\<Andale Mono\>\""}], ",", 
              RowBox[{"Background", "\[Rule]", 
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
                 RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}]}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", "fitnessLandscape", "]"}]}], "}"}]}], 
           "]"}]}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.5"}], ",", 
             RowBox[{"L", "+", "0.5"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Frame", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"True", ",", "True", ",", "False", ",", "False"}], "}"}]}], 
        ",", " ", 
        RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
        RowBox[{"FrameTicks", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{"k", ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "0", ",", "L"}], "}"}]}], "]"}], ",", 
             "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "150"}], ",", 
        RowBox[{"FrameStyle", "\[Rule]", 
