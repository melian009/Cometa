Cell[BoxData[
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"extract", " ", "mutational", " ", "paths"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mutTable", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{
         "allLandscapes", "\[LeftDoubleBracket]", "j", 
          "\[RightDoubleBracket]"}], ",", "2"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
           "]"}], "==", "1"}], "&&", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "==",
           "1"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"identify", " ", "peaks"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"peakIndices", "=", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{
            "allLandscapes", "\[LeftDoubleBracket]", "j", 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
               ">", 
               RowBox[{
                RowBox[{
                "allLandscapes", "\[LeftDoubleBracket]", "j", 
                 "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
                RowBox[{"k", ",", "3"}], "\[RightDoubleBracket]"}]}], "&&", 
              RowBox[{
               RowBox[{"hamDist", "[", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                 ",", 
                 RowBox[{
                  RowBox[{
                  "allLandscapes", "\[LeftDoubleBracket]", "j", 
                   "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
                  RowBox[{"k", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}],
                "\[Equal]", "1"}]}], "&"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "allLandscapes", "\[LeftDoubleBracket]", "j", 
              "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", "}"}]}], "]"}], "//", "Flatten"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"identify", " ", "sinks"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"sinkIndices", "=", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
